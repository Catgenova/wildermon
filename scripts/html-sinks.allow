# Toolbar button: its fixed label and the bound key's name, both escaped (a stored binding comes from the browser's storage).
src/ui/hud.ts	k.btn.innerHTML = codes.length ? `${esc(k.label)} <kbd>${esc(keyName(codes[0]))}</kbd>` : esc(k.label);

# Equipment and health icons: fixed SVG tables (GLYPH, ITEM_ICONS, HEART, PIN_GLYPH, svgOf) indexed by game ids.
